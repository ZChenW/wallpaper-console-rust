# This repository tracks an install-oriented source tree:
#   git clone … && ./install.sh
# Keep tests, e2e, mocks, scripts, and planning docs local-only.

# Rust build artifacts
target/

# Tauri / frontend build artifacts
apps/tauri-gui/frontend/node_modules/
apps/tauri-gui/frontend/dist/
apps/tauri-gui/frontend/dist-mock/
apps/tauri-gui/frontend/tsconfig.tsbuildinfo
apps/tauri-gui/frontend/test-results/
apps/tauri-gui/src-tauri/gen/

# Frontend tests, e2e, and mock harness (local-only)
apps/tauri-gui/frontend/e2e/
apps/tauri-gui/frontend/**/*.test.ts
apps/tauri-gui/frontend/**/*.spec.ts
apps/tauri-gui/frontend/**/*.typecheck.ts
apps/tauri-gui/frontend/tsconfig.tests.json
apps/tauri-gui/frontend/vite.mock.config.ts
apps/tauri-gui/frontend/src/api/mockBridge.ts
apps/tauri-gui/frontend/e2e/screenshots/

# Rust tests (not required for cargo build --release)
**/tests/
**/*_tests.rs
**/test_support.rs
crates/wc-core/src/tests.rs
xtask/tests/

# AI / editor local config
.agents/
.claude/
.codex/
.jj/
.superpowers/
.worktrees/
AGENTS.md

# Planning / agent docs
doc/
docs/
CONTEXT.md

# Development-only scripts and fixtures
scripts/
/tests/
*.html
