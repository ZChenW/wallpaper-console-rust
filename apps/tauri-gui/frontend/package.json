{
  "name": "wallpaper-console-tauri-gui",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "node e2e/run-unit.mjs",
    "smoke": "node e2e/smoke.mjs",
    "verify:local": "npm run lint && npm run typecheck && npm run test:unit && npm run smoke && npm run test:grid-render && npm run test:flow-perf",
    "bench:paging": "node --expose-gc --import ./e2e/register-tests.mjs e2e/paging-benchmark.ts",
    "lint": "eslint src",
    "test:grid-render": "node e2e/grid-render.mjs",
    "test:flow-perf": "node e2e/flow-perf.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.11.0",
    "lucide-react": "^0.468.0",
    "motion-dom": "12.42.2",
    "radix-ui": "^1.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
